# Copiar a .env y rellenar. El archivo .env NUNCA se sube al repositorio.
APP_ENV=local
# Logs: JSON en la nube, texto legible en local
LOG_LEVEL=INFO
LOG_JSON=true
APP_NAME=plataforma
APP_VERSION=0.1.0
GIT_COMMIT=dev
API_V1_PREFIX=/api/v1

# Base de datos. En local, sqlite. En produccion, cadena del SESSION POOLER de Supabase
# (host aws-...pooler.supabase.com, puerto 5432). No usar la conexion directa: es IPv6.
DATABASE_URL=sqlite:///./dev.db
# DATABASE_URL=postgresql+psycopg2://postgres.REF:CAMBIAR@aws-0-REGION.pooler.supabase.com:5432/postgres

# Autenticacion
JWT_SECRET=CAMBIAR_POR_UNA_CADENA_ALEATORIA_LARGA
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# CORS: origenes exactos separados por coma, sin comodin
CORS_ORIGINS=http://localhost:5173,https://ORG.github.io

# PreparadorIA: "reglas" (sin red) o "llm" (AI Scoper con modelo de lenguaje)
PREPARADOR=llm
# Modelo de lenguaje con API compatible con OpenAI. Clave gratuita en https://console.groq.com
# Sin clave, el juez, el tutor, la defensa y el preparador usan su version por reglas.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
# Modelos de respaldo, en orden, si el principal falla (cada modelo de Groq tiene su propia cuota).
LLM_MODELOS_RESPALDO=llama-3.1-8b-instant
# Alternativa Gemini (clave en https://aistudio.google.com/apikey):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash

# EvaluadorAislado: implementacion del puerto de evaluacion
EVALUADOR=simulado

# Credenciales
PREFIJO_CREDENCIAL=SH
URL_BASE_VERIFICACION=http://localhost:5173/#/credenciales
SEED_ON_START=false
